<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.integrationnet.ios-lab</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/integrationnet/bin/start-ios-lab-mac.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/integrationnet/ios-lab.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/integrationnet/ios-lab-error.log</string>
</dict>
</plist>
