<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.integrationnet.appium</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/appium</string>
        <string>--address</string>
        <string>0.0.0.0</string>
        <string>--port</string>
        <string>4723</string>
        <string>--log-level</string>
        <string>debug</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/integrationnet/appium.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/integrationnet/appium-error.log</string>
</dict>
</plist>
